<!--
Packager ISO 8583:1987 simplifie pour la simulation : definit uniquement les champs
utilises par nos scenarios (PAN, montant, STAN, RRN, code autorisation, code reponse, id TPE).
Format compatible org.jpos.iso.packager.GenericPackager.
-->
<!DOCTYPE isopackager SYSTEM "genericpackager.dtd">
<isopackager>
    <isofield
        id="0" length="4" name="Message Type Indicator"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <!--
      Champ bitmap (DE1) : obligatoire pour tout packager derive de
      ISOBasePackager/GenericPackager, meme simplifie - c'est lui qui indique
      quels champs sont presents dans le message. Sans lui, ISOBasePackager.pack()
      leve une NullPointerException des qu'on essaie reellement d'envoyer un
      message sur le fil (getBitMapfieldPackager() retourne null), ce qui ne se
      voit pas dans des tests qui appellent directement process(...) sans
      passer par un vrai ASCIIChannel.
    -->
    <isofield
        id="1" length="8" name="Bitmap"
        class="org.jpos.iso.IFA_BITMAP"/>
    <isofield
        id="2" length="19" name="PAN"
        class="org.jpos.iso.IFA_LLNUM"/>
    <isofield
        id="3" length="6" name="Processing Code"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <isofield
        id="4" length="12" name="Montant"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <isofield
        id="11" length="6" name="STAN"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <isofield
        id="37" length="12" name="RRN"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <isofield
        id="38" length="6" name="Code Autorisation"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <isofield
        id="39" length="2" name="Code Reponse"
        class="org.jpos.iso.IFA_NUMERIC"/>
    <isofield
        id="41" length="16" name="Id TPE"
        class="org.jpos.iso.IF_CHAR"/>
    <isofield
        id="42" length="15" name="Id Commercant"
        class="org.jpos.iso.IF_CHAR"/>
</isopackager>
